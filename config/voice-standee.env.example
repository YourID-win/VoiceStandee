# Copied to /etc/voice-standee/voice-standee.env by deploy/setup-first-time-with-sudo.sh (never overwritten later).
# Put the real token in the copy, never here and never in git. No quotes, no spaces around the "=".
VOICE_STANDEE_TOKEN=replace-with-discord-bot-token

# The Discord user id of the person who looks after the bot (Discord: Settings > Advanced > Developer Mode, then right-click
# yourself > Copy User ID). Reports about pictures are sent to them as a private message, and only they can use /standee-admin.
# Leave empty and reporting and moderation are off.
VOICE_STANDEE_OWNER=

# The overlay web server listens on this machine only; Cloudflare Tunnel brings the public address to it.
VOICE_STANDEE_BIND=127.0.0.1
VOICE_STANDEE_PORT=8780
# The address people put into OBS (shown by /立ち絵 obs).
VOICE_STANDEE_BASE_URL=https://standee.yuaworks.com
VOICE_STANDEE_DATA=/var/lib/voice-standee

# Memory limit of the program, and where the voice-encryption library is unpacked (a directory the service may write).
JAVA_OPTS=-Xms64m -Xmx512m -Djava.io.tmpdir=/var/lib/voice-standee/tmp
# Leave VOICE_STANDEE_GUILD unset in production: the slash commands are then registered for every server.
